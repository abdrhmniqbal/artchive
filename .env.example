# Copy to .dev.vars for local dev (NEVER commit real values).
# Production: `wrangler secret put <NAME>` for each secret below.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://artchive.web.id
ANONDROP_KEY=your-anondrop-key
RESEND_API_KEY=re_your-key (optional in dev: links are logged to console instead)
EMAIL_FROM=Artchive <noreply@artchive.app>
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com (optional: hides Google button when unset)
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
